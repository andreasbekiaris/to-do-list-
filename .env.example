# Copy to .env.local for local development. Never commit real values.
# Add the same names in Vercel > Project > Settings > Environment Variables.

# Neon Marketplace injects DATABASE_URL in Vercel.
DATABASE_URL=
# Optional direct Neon URL for migrations; DATABASE_URL is the fallback.
DATABASE_URL_UNPOOLED=

# Generate privately: openssl rand -base64 32
AUTH_SECRET=
# Private code (16–256 characters) for creating or recovering the owner account.
# Keep it private; /forgot-password uses it to verify password resets.
ACCOUNT_SETUP_KEY=

# Local origin. In Vercel use the stable production origin instead.
AUTH_URL=http://localhost:3000

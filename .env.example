# Copy to .env.local for local development. Never commit real values.
# Add the same names in Vercel > Project > Settings > Environment Variables.

# Neon Marketplace injects DATABASE_URL in Vercel.
DATABASE_URL=
# Optional direct Neon URL for migrations; DATABASE_URL is the fallback.
DATABASE_URL_UNPOOLED=

# Generate privately: openssl rand -base64 32
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Your numeric GitHub account ID, NOT your username.
ALLOWED_GITHUB_ID=

# Only for local development. Vercel detects its production URL automatically.
AUTH_URL=http://localhost:3000
